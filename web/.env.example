# web/.env.local 로 복사한 뒤 실제 값을 채우세요. (.env.local 은 git 추적 안 됨)

# [필수] 백엔드 주소 — Next 서버가 /api/v1/* 요청을 이 주소로 중계합니다.
# 브라우저에 노출되지 않는 서버 전용 값이라 https 배포에서도 mixed content 문제가 없습니다.
# 예: http://<backend-host>:8080
API_PROXY_TARGET=

# (선택) 브라우저가 백엔드를 직접 호출하게 만들 때만 지정하세요.
# 비워두면 same-origin 으로 요청해서 위 프록시를 타게 됩니다. https 배포 시에는 비워두세요.
# NEXT_PUBLIC_API_BASE_URL=

# (선택) 시연용 아파트명 표시 override.
# 공통 기본값은 web/.env 에 있고(잠실엘스), 다른 이름으로 시연할 때만 여기서 덮어쓰세요.
# NEXT_PUBLIC_DEMO_APARTMENT_NAME=
